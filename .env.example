# Copy to .env and fill in. Only GEMINI_API_KEY is required.
GEMINI_API_KEY=
# The teacher's voice. Without these, the board uses the browser's built-in voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Tiger Data (Postgres + TimescaleDB) for the speech measurements. Without it, they are kept in data/speech.jsonl.
DATABASE_URL=
